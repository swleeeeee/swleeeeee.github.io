      <description>&lt;h1 id=&#34;water-jet-reference-cases&#34;&gt;Water Jet reference cases&lt;/h1&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Thickness&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Material&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Z-axis mechanical coordinate&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Velosity&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Breakage&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Cutter compensation(contract internally)&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Cutter compensation(expand externally)&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Delay&lt;/strong&gt;&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Commment&lt;/strong&gt;&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;2mm&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;304 stainless-steel&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;z=-55.004&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;v=100mm/min&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1.23&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.80(square),0.83(circle)&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1.0&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;default&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;clamp tightly&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;5mm&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;304 stainless-steel&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;z=-56.88&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;v=50mm/min&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1.2&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;default&lt;/td&gt;&#xA;          &lt;td&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;15mm&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;aluminum&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;z=-45.004&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;v=30mm/min&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1.2&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;default&lt;/td&gt;&#xA;          &lt;td&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;2.5mm&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;composite(stainless-steel/glass-fiber/stainless-steel)&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;z=-52.04&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;v=200mm/min&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1.3&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;0.9&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;Low pressure perforation&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;mind the cutting direction&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;Cutter compensation is not an absolute value, it&amp;rsquo;s determined by the distance between sandpipe lowest tip and the upper face of the panel.&lt;/p&gt;</description>
